# =====================================================
# CENK ULUŞIK ENGLISH ACADEMY - Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Cenk Uluşık English Academy"

# Contact Configuration
NEXT_PUBLIC_CONTACT_EMAIL=info@cenkulusik.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+905551234567

# Demo Mode (set to 'true' to enable demo video player and test data)
NEXT_PUBLIC_DEMO_MODE=true

# Video Provider (optional - leave empty for demo mode)
# Supported: 'mux' | 'cloudflare' | 'demo'
NEXT_PUBLIC_VIDEO_PROVIDER=demo
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFLARE_STREAM_TOKEN=

# Rate Limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
